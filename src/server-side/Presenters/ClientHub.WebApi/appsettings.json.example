{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings":
  {
    "Default": ""
  },
  "Caching": {
    "ExpirationInMinutes": "5",
    "SingleExpirationInMinutes": "10",
    "Redis": {
      "Configuration": "localhost:6379",
      "InstanceName": "local"
    }
  },
  "Serilog": {
      "MinimumLevel": {
        "Default": "Information"
      },
      "WriteTo": [
        {
          "Name": "Console"
        }
      ]
    }
}
