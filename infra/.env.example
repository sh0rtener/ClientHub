POSTGRES_USER=postgres
POSTGRES_HOST=postgres
POSTGRES_PASSWORD= postgres
ConnectionStrings__Default="Host=postgres;Port=5432;Database=${POSTGRES_HOST};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"
ConnectionStrings__Redis="localhost:6379"
Caching__ExpirationInMinutes=5
Caching__SingleExpirationInMinutes=10
Caching__Redis__Configuration="localhost:6379"
Caching__Redis__InstanceName=local